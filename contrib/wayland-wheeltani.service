[Unit]
Description=Progressive middle-button autoscroll daemon for Wayland
Documentation=https://github.com/docloulou/Wayland-Wheeltani
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wayland-wheeltani --no-interactive --config %h/.config/Wayland-Wheeltani/config.toml
Restart=on-failure
RestartSec=2
# kdotool scripts must be shared with KWin and writable under ProtectSystem=strict.
PrivateTmp=false
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/Wayland-Wheeltani /tmp

[Install]
WantedBy=default.target
